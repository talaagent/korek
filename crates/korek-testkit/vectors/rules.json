{
  "$comment": "Shared validation vectors: each case is a field type and validate block, with values every target must accept and reject. Run by korek-testkit (Rust, via the generated code), ts/vectors.test.ts (Zod) and ts/protovalidate.test.ts (the generated Protobuf, via protovalidate-es).",
  "cases": [
    {"name": "min_len", "type": "string", "validate": "min_len 2", "valid": ["ab", "日本"], "invalid": ["", "a", "日"]},
    {"name": "max_len", "type": "string", "validate": "max_len 3", "valid": ["", "abc"], "invalid": ["abcd"]},
    {"name": "len", "type": "string", "validate": "len 2", "valid": ["ab"], "invalid": ["a", "abc"]},
    {"name": "max_bytes", "type": "string", "validate": "max_bytes 3", "valid": ["abc", "é"], "invalid": ["日本"]},
    {"name": "pattern", "type": "string", "validate": "pattern \"^[a-z]+$\"", "valid": ["abc"], "invalid": ["ABC", "a1"]},
    {"name": "prefix", "type": "string", "validate": "prefix \"https://\"", "valid": ["https://x"], "invalid": ["http://x"]},
    {"name": "suffix", "type": "string", "validate": "suffix \".kdl\"", "valid": ["a.kdl"], "invalid": ["a.json"]},
    {"name": "contains", "type": "string", "validate": "contains \"@\"", "valid": ["a@b"], "invalid": ["ab"]},
    {"name": "not_contains", "type": "string", "validate": "not_contains \" \"", "valid": ["ab"], "invalid": ["a b"]},
    {"name": "in", "type": "string", "validate": "in \"a\" \"b\"", "valid": ["a", "b"], "invalid": ["c"]},
    {"name": "not_in", "type": "string", "validate": "not_in \"root\"", "valid": ["user"], "invalid": ["root"]},
    {"name": "const", "type": "string", "validate": "const \"v1\"", "valid": ["v1"], "invalid": ["v2"]},
    {"name": "email", "type": "string", "validate": "email", "valid": ["a.b@example.com"], "invalid": ["a@", "@example.com", "a b@example.com"]},
    {"name": "uuid", "type": "string", "validate": "uuid", "valid": ["123e4567-e89b-12d3-a456-426614174000"], "invalid": ["123e4567", "123e4567-e89b-12d3-a456-42661417400g"]},
    {"name": "ulid", "type": "string", "validate": "ulid", "valid": ["01ARZ3NDEKTSV4RRFFQ69G5FAV"], "invalid": ["01ARZ3NDEKTSV4RRFFQ69G5FA"]},
    {"name": "ipv4", "type": "string", "validate": "ipv4", "valid": ["192.168.0.1"], "invalid": ["256.1.1.1", "::1"]},
    {"name": "ipv6", "type": "string", "validate": "ipv6", "valid": ["::1", "2001:db8::1"], "invalid": ["1.2.3.4", "2001:db8::g"]},
    {"name": "url", "type": "string", "validate": "url", "valid": ["https://example.com/a"], "invalid": ["example.com", "not a url"]},
    {"name": "date", "type": "string", "validate": "date", "valid": ["2024-02-29", "2000-02-29"], "invalid": ["2023-02-29", "2024-13-01", "2024-04-31", "1900-02-29"]},
    {"name": "datetime", "type": "string", "validate": "datetime", "valid": ["2024-01-02T03:04:05Z", "2024-01-02T03:04:05.5+02:00"], "invalid": ["2024-01-02 03:04:05", "2024-01-02T03:04:05", "2023-02-29T00:00:00Z", "2024-01-02T24:00:00Z", "2024-01-02T03:60:00Z"]},
    {"name": "e164", "type": "string", "validate": "e164", "valid": ["+14155552671"], "invalid": ["14155552671", "+0123456"]},
    {"name": "lowercase", "type": "string", "validate": "lowercase", "valid": ["abc-1"], "invalid": ["aBc"]},
    {"name": "base64", "type": "string", "validate": "base64", "valid": ["Zm9v", ""], "invalid": ["Zm9", "Zm9v!"]},
    {"name": "int_range", "type": "i64", "validate": "gte -5; lte 5", "valid": [-5, 0, 5], "invalid": [-6, 6]},
    {"name": "exclusive", "type": "i32", "validate": "gt 0; lt 10", "valid": [1, 9], "invalid": [0, 10]},
    {"name": "multiple_of", "type": "u32", "validate": "multiple_of 5", "valid": [0, 10], "invalid": [3]},
    {"name": "float_range", "type": "f64", "validate": "gte 0.0; lte 1.0", "valid": [0, 0.5, 1], "invalid": [-0.1, 1.5]},
    {"name": "int_in", "type": "u64", "validate": "in 1 2 3", "valid": [2], "invalid": [4]},
    {"name": "bool_const", "type": "bool", "validate": "const #true", "valid": [true], "invalid": [false]},
    {"name": "min_items", "type": "list<string>", "validate": "min_items 1; max_items 2", "valid": [["a"], ["a", "b"]], "invalid": [[], ["a", "b", "c"]]},
    {"name": "unique", "type": "list<i64>", "validate": "unique", "valid": [[1, 2]], "invalid": [[1, 1]]},
    {"name": "items", "type": "list<string>", "validate": "items { min_len 1 }", "valid": [["a"]], "invalid": [[""]]},
    {"name": "pairs", "type": "map<string,i64>", "validate": "max_pairs 1; keys { pattern \"^[a-z]+$\" }; values { gte 0 }", "valid": [{}, {"a": 1}], "invalid": [{"a": 1, "b": 2}, {"A": 1}, {"a": -1}]},
    {"name": "duration", "type": "duration", "validate": "gte \"1s\"; lte \"60s\"", "valid": ["1s", "30.5s"], "invalid": ["0.5s", "61s"]},
    {"name": "timestamp", "type": "timestamp", "validate": "gt \"2020-01-01T00:00:00Z\"", "valid": ["2021-01-01T00:00:00Z"], "invalid": ["2019-01-01T00:00:00Z"]}
  ]
}
