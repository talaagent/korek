struct SearchRequest {
  field query "string" { validate { min_len 1 } }
  field limit "u32" default=20 { validate { gte 1; lte 100 } }
}

struct SearchResponse {
  field contacts "list<Contact>"
}

struct GetRequest {
  field id "string" { validate { uuid } }
}

struct GetResponse {
  field contact "Contact"
}

service ContactsService {
  doc "Look up contacts."
  rpc Search input="SearchRequest" output="SearchResponse" idempotency="no_side_effects" {
    doc "Full-text search over names and emails."
  }
  rpc Get input="GetRequest" output="GetResponse" idempotency="no_side_effects"
}
