package "example.v1"

enum Backend {
  doc "Which provider runs a turn."
  variant claude { doc "Claude Code." }
  variant codex { doc "OpenAI Codex." }
}

struct McpStdio {
  doc "An MCP server started as a child process."
  example #"{"command": "npx", "args": ["-y", "@acme/mcp"]}"#
  field command "string" {
    doc "The program to run."
    validate { min_len 1 }
  }
  field args "list<string>" optional=#true
  field env "map<string,string>" optional=#true {
    doc "Extra environment variables."
    validate { keys { pattern "^[A-Z_][A-Z0-9_]*$" } }
  }
}

struct McpHttp {
  doc "An MCP server reached over HTTP."
  field url "string" {
    validate { url; prefix "https://" message="MCP servers must use HTTPS" }
    example "https://mcp.example.com/sse"
  }
  field timeout_ms "u32" default=30000 {
    unit "milliseconds"
    validate { gte 1; lte 600000 }
  }
}

union McpServer tag="type" {
  doc "How to reach an MCP server."
  validate { required }
  variant stdio "McpStdio"
  variant http "McpHttp"
}

// Untagged: the first variant whose type matches.
union Limit {
  doc "A limit: a count, or a named preset."
  variant count "u64"
  variant preset "string"
}

struct Contact {
  description """
    A person in the address book.

    Contacts are matched by `id`; names are free text.
    """
  field id "string" { validate { uuid } }
  field name "string" { validate { min_len 1; max_len 200 } }
  field emails "list<string>" {
    validate {
      max_items 10
      unique
      items { email; max_len 254 }
    }
  }
  field score "f64" optional=#true { validate { gte 0.0; lte 1.0 } }
  field avatar "bytes" optional=#true { validate { max_len 65536 } }
  field tags "map<string,list<string>>" optional=#true {
    doc "Tag groups."
    validate { max_pairs 16 }
  }
  field created "timestamp" { validate { lt_now } }
  field phone "string" optional=#true { validate { e164 }; since "1.2" }
  field extra "json" optional=#true {
    doc "Free-form metadata from the importer."
    example #"{"source": "vcard", "rev": 3}"#
  }
}
