{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by korek from the schema. Do not edit.",
  "$defs": {
    "SearchRequest": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1
        },
        "limit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "allOf": [
            {
              "minimum": 1
            },
            {
              "maximum": 100
            }
          ],
          "default": 20
        }
      },
      "required": [
        "query"
      ]
    },
    "SearchResponse": {
      "type": "object",
      "properties": {
        "contacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Contact"
          }
        }
      },
      "required": [
        "contacts"
      ]
    },
    "GetRequest": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "id"
      ]
    },
    "GetResponse": {
      "type": "object",
      "properties": {
        "contact": {
          "$ref": "#/$defs/Contact"
        }
      },
      "required": [
        "contact"
      ]
    },
    "Backend": {
      "type": "string",
      "enum": [
        "claude",
        "codex"
      ],
      "description": "Which provider runs a turn."
    },
    "McpStdio": {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1,
          "description": "The program to run."
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Z_][A-Z0-9_]*$"
          },
          "description": "Extra environment variables."
        }
      },
      "required": [
        "command"
      ],
      "description": "An MCP server started as a child process.",
      "examples": [
        {
          "command": "npx",
          "args": [
            "-y",
            "@acme/mcp"
          ]
        }
      ]
    },
    "McpHttp": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https:\\/\\/",
          "examples": [
            "https://mcp.example.com/sse"
          ]
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "allOf": [
            {
              "minimum": 1
            },
            {
              "maximum": 600000
            }
          ],
          "description": "Unit: milliseconds.",
          "default": 30000
        }
      },
      "required": [
        "url"
      ],
      "description": "An MCP server reached over HTTP."
    },
    "McpServer": {
      "oneOf": [
        {
          "$ref": "#/$defs/McpStdio",
          "properties": {
            "type": {
              "const": "stdio"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "$ref": "#/$defs/McpHttp",
          "properties": {
            "type": {
              "const": "http"
            }
          },
          "required": [
            "type"
          ]
        }
      ],
      "description": "How to reach an MCP server."
    },
    "Limit": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "string"
        }
      ],
      "description": "A limit: a count, or a named preset."
    },
    "Contact": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "emails": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "maxItems": 10,
          "uniqueItems": true
        },
        "score": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "avatar": {
          "type": "string",
          "contentEncoding": "base64"
        },
        "tags": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "maxProperties": 16,
          "description": "Tag groups."
        },
        "created": {
          "type": "string",
          "format": "date-time"
        },
        "phone": {
          "type": "string",
          "pattern": "^\\+[1-9]\\d{6,14}$",
          "description": "Since 1.2."
        },
        "extra": {
          "description": "Free-form metadata from the importer.",
          "examples": [
            {
              "source": "vcard",
              "rev": 3
            }
          ]
        }
      },
      "required": [
        "id",
        "name",
        "emails",
        "created"
      ],
      "description": "A person in the address book.\n\nContacts are matched by `id`; names are free text."
    },
    "Keys": {
      "type": "object",
      "description": "Every key, by its full dotted name.",
      "properties": {
        "session.steer.enabled": {
          "type": "boolean",
          "description": "Give a new message to the running turn.",
          "title": "Steering",
          "default": false
        },
        "session.backend": {
          "$ref": "#/$defs/Backend",
          "default": "claude"
        },
        "session.timeout": {
          "type": "string",
          "pattern": "^-?\\d+(\\.\\d+)?s$",
          "description": "Turn timeout.",
          "default": "600s"
        },
        "session.temperature": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 2.0,
          "default": 0.7
        },
        "session.turn_limit": {
          "$ref": "#/$defs/Limit",
          "default": 50
        },
        "session.max_turns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "description": "Also known as: turns.max.",
          "deprecated": true,
          "default": 20
        },
        "claude.mcp_servers": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/McpServer"
          },
          "examples": [
            {
              "files": {
                "type": "stdio",
                "command": "mcp-files"
              }
            }
          ],
          "default": {}
        },
        "claude.model": {
          "type": "string",
          "pattern": "^[a-z0-9.-]+$",
          "description": "Model override; unset means the account default."
        },
        "claude.api_key": {
          "type": "string",
          "minLength": 20,
          "writeOnly": true
        },
        "claude.metadata": {
          "description": "Sent with each request.",
          "default": {
            "team": "core"
          }
        }
      }
    }
  }
}
